# Google Cloud OAuth desktop client (Gmail API enabled).
# Authorized redirect URI: http://127.0.0.1:53682/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. The CLI uses Gmail "me"; this is only for your own notes.
GMAIL_USER=

# Optional. On Fly (FLY_APP_NAME set), CV proof Save requires this as
# Authorization: Bearer <value>. Local pnpm dev allows Save without it.
CV_SAVE_SECRET=
